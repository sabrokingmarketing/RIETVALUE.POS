{
  "name": "nursery-pos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=.env --conditions=react-server --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --conditions=react-server --import tsx scripts/seed.ts",
    "owner:reset-password": "node --env-file-if-exists=.env --conditions=react-server --import tsx scripts/reset-owner-password.ts",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "local": "NEXT_DIST_DIR=.next-prod next build && NEXT_DIST_DIR=.next-prod next start -H 0.0.0.0 -p 3000"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "better-auth": "^1.7.18",
    "bwip-js": "^4.11.4",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.70.0",
    "next": "^16.4.5",
    "nodemailer": "^10.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^5.1.0",
    "zxing-wasm": "^3.1.6"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
