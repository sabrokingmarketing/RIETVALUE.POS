# --- Required ---------------------------------------------------------------
# PostgreSQL connection string (one database per environment)
DATABASE_URL=postgres://nursery:nursery@localhost:5432/nursery_dev
# Public URL of the app exactly as staff and customers reach it (no trailing slash)
APP_URL=http://localhost:3000
# Long random secret for session signing. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-32-plus-random-characters
# One-time token required on /setup to create the first owner account.
# Generate with: openssl rand -hex 16  — remove or rotate after setup.
SETUP_TOKEN=replace-me

# --- Optional ---------------------------------------------------------------
# Where uploaded plant photos are stored (must be persistent and backed up)
UPLOAD_DIR=./uploads
# SMTP for owner password-reset e-mails. If unset, reset links are written to
# the server log and owners can use `npm run owner:reset-password` on the server.
SMTP_URL=
MAIL_FROM=
