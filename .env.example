# --- Required ---------------------------------------------------------------
# PostgreSQL connection string (one database per environment)
DATABASE_URL=postgres://nursery:CHANGE_ME@localhost:5432/nursery
# Public HTTPS address of the app, exactly as staff reach it (no trailing slash)
APP_URL=https://till.example.co.za
# Long random secret for session signing. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-32-plus-random-characters
# One-time code required on /setup to create the first owner. Generate: openssl rand -hex 16
# Remove it (or rotate it) once the owner account exists.
SETUP_TOKEN=replace-me

# --- Optional ---------------------------------------------------------------
PORT=3000
# Persistent directory for product photos (must be included in backups)
UPLOAD_DIR=/srv/nursery/uploads
# SMTP for owner password-reset e-mails, e.g. smtps://user:pass@smtp.example.co.za:465
# If unset, reset links go to the server log and `npm run owner:reset-password` works on the server.
SMTP_URL=
MAIL_FROM=
# Background jobs (resume imports, clean abandoned uploads) run inside the app every 30 s.
# Set to 1 only on extra app instances if you run more than one.
DISABLE_SCHEDULER=
# Docker Compose only: password for the bundled PostgreSQL container
POSTGRES_PASSWORD=
